# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to Supabase: point this at any Postgres database (Neon, Railway, self-hosted,
# etc.) and leave the Supabase vars above unset. Run schema.sql against it once to create the
# tables. Ignored if NEXT_PUBLIC_SUPABASE_URL is set.
DATABASE_URL=

# Session signing secret — required in production. Generate with:
#   openssl rand -hex 32
# If unset in production the app will refuse to sign in.
SESSION_SECRET=

# Encrypts Instagram access tokens at rest in the database (AES-256-GCM).
# Generate with the same command: openssl rand -hex 32
# Required in production. Changing this key makes previously-stored tokens
# unreadable — connected accounts would need to reconnect.
ENCRYPTION_KEY=

# Protects the /api/cron/refresh-tokens endpoint. Vercel automatically sends this as a
# Bearer token when it triggers the cron job defined in vercel.json — set the same value
# here and in Vercel's env vars. Generate with: openssl rand -hex 32
CRON_SECRET=

# Instagram / Meta App
# This app uses "Instagram API with Instagram Login" (Business Login) — NOT Instagram
# Basic Display and NOT Facebook Login. Dashboard: https://developers.facebook.com/apps/
#   -> Your App -> Instagram -> API setup with Instagram business login
#
# App ID / secret: use the *Instagram app ID* and *Instagram app secret* shown on that
# Instagram product page — NOT the parent Meta app ID from Settings -> Basic.
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: parent Meta app secret (Settings -> Basic). Only needed if webhook signature
# validation fails with 401s because Meta signs deliveries with the parent app secret.
META_APP_SECRET=
# Must exactly match one of the "OAuth redirect URIs" in Instagram -> Business login settings
# (character-for-character: scheme, host, path, no trailing slash mismatch).
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Any random string; enter the same value in the webhook subscription form in the dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
